        "card3",
        "card4",
        "card5",
        "card6",
        "addr1",
        "addr2",
        "dist1",
        "dist2",
        "P_emaildomain",
        "R_emaildomain"
      ]
    },
    "ulb_creditcard": {
      "name": "ULB Credit Card Fraud",
