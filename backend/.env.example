# FinGuard Core Backend Environment Configuration
ENVIRONMENT=local
LOG_LEVEL=INFO
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finguard

# Supabase Auth
SUPABASE_URL=https://placeholder-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-secret-service-role-key
SUPABASE_JWT_SECRET=placeholder-jwt-secret

# Independent ML Backend Service
ML_SERVICE_URL=http://localhost:8001

# AI / RAG Investigation Assistant
LLM_PROVIDER=openai
LLM_API_KEY=placeholder-llm-api-key
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
