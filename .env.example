# ==============================================================================
# FinGuard AI - Master Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. For frontend specific overrides in development, copy to frontend/.env.local:
#      cp .env.example frontend/.env.local
# 3. Fill in the values for your environment.
# 4. Never commit .env, .env.local, or actual secret keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General & Runtime Configuration
# ------------------------------------------------------------------------------
# Environment: local | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO
DEBUG=true

# ------------------------------------------------------------------------------
# 2. Frontend Configuration (Next.js)
# Note: Any variable exposed to the client browser MUST start with NEXT_PUBLIC_
# ------------------------------------------------------------------------------
# Public URL where the frontend is hosted
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL for the FinGuard core backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase Client Authentication (Public)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-public-anon-key

# Demo Mode: Allows full UI inspection with synthetic offline data
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 3. Core Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL Database Connection
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finguard

# Supabase Server-Side Auth & Admin (Secret - Never expose to browser)
SUPABASE_URL=https://placeholder-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-secret-service-role-key
SUPABASE_JWT_SECRET=placeholder-jwt-secret

# Independent ML Backend Service URL
ML_SERVICE_URL=http://localhost:8001

# ------------------------------------------------------------------------------
# 4. ML Backend Configuration (Python / FastAPI)
# ------------------------------------------------------------------------------
ML_HOST=0.0.0.0
ML_PORT=8001
MODEL_ARTIFACTS_DIR=./artifacts/models
FEATURE_CONFIG_PATH=./config/features.json
SCORING_CONFIG_PATH=./config/scoring_rules.json
ENABLE_SHAP_EXPLANATIONS=true

# ------------------------------------------------------------------------------
# 5. AI / RAG Investigation Assistant Configuration
# ------------------------------------------------------------------------------
# LLM Provider: openai | anthropic | groq | openrouter | local
LLM_PROVIDER=openai
LLM_API_KEY=placeholder-llm-api-key
LLM_MODEL=gpt-4o-mini

# Embeddings Provider: openai | local | huggingface
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=placeholder-embedding-api-key
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG Knowledge Base Database URL (defaults to main PostgreSQL with pgvector)
VECTOR_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finguard

# ------------------------------------------------------------------------------
# 6. Database / Infrastructure (Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finguard
POSTGRES_PORT=5432
